# Port the API listens on.
PORT=5000

# MongoDB connection string.
MONGODB_URI=

# Comma-separated list of origins allowed to call the API, e.g.
#   CORS_ORIGINS=https://pitwall.example.com,https://www.pitwall.example.com
#
# Leave unset in development to allow any origin. REQUIRED in production —
# the server refuses to start without it when NODE_ENV=production, rather
# than silently exposing the API to every site on the internet.
CORS_ORIGINS=

# Set to "production" on a deployed instance.
NODE_ENV=

# Rate limiting, per IP. Defaults shown.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# NOTE ON SERVERLESS (Vercel). The rate limiter above is in-memory and
# per-container, so it does not meaningfully throttle when deployed as
# functions. Use a shared store if real limiting is required.
