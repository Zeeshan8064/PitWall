# Only api/index.ts is a serverless function. Without this Vercel globs other
# .ts files as entrypoints too and fails on src/app.ts, which exports
# createApp() rather than a default handler:
#
#   Invalid export found in module ".../src/app.js"
#
# src/ is still bundled — api/index.ts imports from it — this only stops those
# files being treated as functions in their own right.
dist
node_modules
src/scripts
